{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "cloudflare/shield-and-move": false,
      "seasonal-pages": false,
      "holiday-pins": false
    }
  }
}
