    <div class="price-tag">
      <span class="amt">$9</span>
      <span class="desc">one-time, forever</span>
    </div>

    <ul class="features">
      <li>Up to 150 pages a day (free: 2 a day)</li>
      <li>No watermark on PDFs</li>
      <li>Combine all your pages into one PDF book</li>
      <li>Commercial use: sell your pages on Etsy &amp; KDP</li>
      <li>Print-ready letter-size PDFs</li>
      <li>Priority support + all future updates</li>
    </ul>

    <a href="https://dorukctn.gumroad.com/l/uynqt" target="_blank" rel="noopener" class="btn btn-block">Get Pro for $9</a>

    <div class="or">or</div>

    <p class="hint">Already purchased? Enter your purchase email or the license key from your Gumroad receipt.</p>
    <input type="text" id="licenseEmail" placeholder="you@email.com or license key" autocomplete="email" spellcheck="false" aria-label="Purchase email or license key">
    <button type="button" class="btn btn-dark btn-block" onclick="verifyLicense()">Activate Pro</button>
    <div class="modal-status" id="licenseStatus" role="status"></div>
  </div>
</div>

<%- include('partials/footer') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
let selectedStyle = 'medium';
let generatedImages = JSON.parse(sessionStorage.getItem('generated_images') || '[]');

function esc(s){
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// Images are base64 data URLs (~1MB each) and sessionStorage caps out around 5MB.
// Persisting is a convenience, not a requirement: it must never throw, because a
// QuotaExceededError here used to surface as "Connection error" and hide the image.
function persistImages(){
  let keep = Math.min(generatedImages.length, 20);
  while(keep > 0){
    try {
      sessionStorage.setItem('generated_images', JSON.stringify(generatedImages.slice(0, keep)));
      return;
    } catch(e){
      keep = Math.floor(keep / 2);
    }
  }
  try { sessionStorage.removeItem('generated_images'); } catch(e){}
}
let proEmail = localStorage.getItem('pro_email') || '';

function isProUser(){ return !!proEmail; }

function selectStyle(style){
  selectedStyle = style;
  document.querySelectorAll('.option-card').forEach(c => {
    c.classList.remove('active');
    c.setAttribute('aria-pressed', 'false');
  });
  const chosen = document.querySelector(`[data-style="${style}"]`);
  chosen.classList.add('active');
  chosen.setAttribute('aria-pressed', 'true');
}

function useExample(el){
  document.getElementById('promptInput').value = el.textContent.trim();
  updateCharCount();
}

function updateCharCount(){
  const len = document.getElementById('promptInput').value.length;
  document.getElementById('charCount').textContent = len;
}

document.getElementById('promptInput').addEventListener('input', updateCharCount);

async function generatePage(){
  const prompt = document.getElementById('promptInput').value.trim();
  if(prompt.length < 3){
    alert('Please describe what you want to draw (at least 3 characters)');
    return;
  }

  const btn = document.getElementById('generateBtn');
  const loading = document.getElementById('loadingArea');
  btn.disabled = true;
  btn.textContent = 'Generating...';
  loading.classList.add('active');

  try {
    const res = await fetch('/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt, style: selectedStyle, email: proEmail })
    });
    const data = await res.json();

    if(!res.ok){
      if(data.limitReached){
        loading.classList.remove('active');
        openProModal();
      } else {
        alert(data.error || 'Generation failed');
      }
      btn.disabled = false;
      btn.textContent = 'Generate coloring page';
      loading.classList.remove('active');
      return;
    }

    // Render first: a storage failure must never hide an image the user paid for.
    generatedImages.unshift({ url: data.imageUrl, prompt, time: Date.now() });
    renderGallery();
    persistImages();

    // Update usage display
    if(data.remaining >= 0 && data.remaining < 999){
      document.getElementById('usageBar').innerHTML = data.remaining > 0
        ? `<strong>${data.remaining}</strong> free pages left today. <a href="javascript:void(0)" onclick="openProModal()">See Pro (up to 150 a day)</a>`
        : `Daily limit reached. <a href="javascript:void(0)" onclick="openProModal()">See Pro (up to 150 a day)</a>`;
    }
  } catch(e){
    alert('Connection error. Please try again.');
  }

  btn.disabled = false;
  btn.textContent = 'Generate coloring page';
  loading.classList.remove('active');
}

function renderGallery(){
  const section = document.getElementById('gallerySection');
  const gallery = document.getElementById('gallery');

  if(generatedImages.length === 0){
    section.classList.remove('active');
    return;
  }

  section.classList.add('active');
  gallery.innerHTML = generatedImages.map((img, i) => `
    <div class="image-card">
      <span class="label">${esc(img.prompt.substring(0, 30))}${img.prompt.length > 30 ? '…' : ''}</span>
      <img src="${img.url}" alt="${esc(img.prompt)}" loading="lazy">
      <div class="actions">
        <button type="button" class="btn-small" onclick="downloadSingle('${img.url}', '${i}')">PDF</button>
        <button type="button" class="btn-small btn-small-outline" onclick="downloadImage('${img.url}', '${i}')">PNG</button>
        <button type="button" class="btn-small btn-small-outline" onclick="removeImage(${i})">Remove</button>
      </div>
    </div>
  `).join('');
}

// === CLIENT-SIDE PDF ===
// Built in the browser with jsPDF. Nothing is uploaded, so there is no
// server payload limit: a 100-page book works the same as a 1-page one.

const PAGE_W = 612, PAGE_H = 792, MARGIN = 30;
const AREA_W = PAGE_W - MARGIN * 2;   // 552
const AREA_H = PAGE_H - MARGIN * 2;   // 732

function loadImageDims(src){
  return new Promise((resolve, reject) => {
    const im = new Image();
    im.onload = () => resolve({ w: im.naturalWidth || 1024, h: im.naturalHeight || 1024 });
    im.onerror = () => reject(new Error('Image could not be read'));
    im.src = src;
  });
}

function drawWatermark(doc){
  doc.setFontSize(11);
  doc.setTextColor(204, 0, 0);
  doc.text(
    'FREE PREVIEW. Not for resale. Get Pro for $9 (150 pages/day, commercial use): coloringpagemaker.app',
    PAGE_W / 2, 22, { align: 'center', maxWidth: 572 }
  );
  doc.setFontSize(10);
  doc.setTextColor(102, 102, 102);
  doc.text('Generated free at coloringpagemaker.app', PAGE_W / 2, PAGE_H - 22, { align: 'center' });
}

async function buildPDF(urls, withWatermark){
  if(!window.jspdf || !window.jspdf.jsPDF){
    throw new Error('PDF library failed to load. Please refresh the page and try again.');
  }
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'pt', format: 'letter', compress: true });

  for(let i = 0; i < urls.length; i++){
    if(i > 0) doc.addPage();

    const { w, h } = await loadImageDims(urls[i]);
    const scale = Math.min(AREA_W / w, AREA_H / h);
    const dw = w * scale, dh = h * scale;
    const x = MARGIN + (AREA_W - dw) / 2;
    const y = MARGIN + (AREA_H - dh) / 2;

    doc.addImage(urls[i], 'PNG', x, y, dw, dh, undefined, 'FAST');
    if(withWatermark) drawWatermark(doc);
  }
  return doc;
}

function savePDF(doc, filename){
  doc.save(filename);
}

async function downloadSingle(url, idx){
  try {
    const doc = await buildPDF([url], !isProUser());
    savePDF(doc, `coloring-page-${idx}.pdf`);
  } catch(e){
    alert(e.message || 'Download failed');
  }
}

async function downloadImage(url, idx){
  const a = document.createElement('a');
  a.href = url;
  a.download = `coloring-page-${idx}.png`;
  a.target = '_blank';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
}

async function downloadAllPDF(){
  if(generatedImages.length === 0) return;

  if(!isProUser() && generatedImages.length > 1){
    alert('The free version downloads one page per PDF. Pro combines all your pages into one coloring book.');
    openProModal();
    return;
  }

  const btn = event && event.target ? event.target : null;
  const original = btn ? btn.textContent : '';
  if(btn){ btn.disabled = true; btn.textContent = 'Building PDF...'; }

  try {
    const urls = generatedImages.map(i => i.url);
    const doc = await buildPDF(urls, !isProUser());
    savePDF(doc, 'my-coloring-book.pdf');
  } catch(e){
    alert(e.message || 'Download failed');
  } finally {
    if(btn){ btn.disabled = false; btn.textContent = original; }
  }
}

function removeImage(i){
  generatedImages.splice(i, 1);
  persistImages();
  renderGallery();
}

function openProModal(){
  document.getElementById('proModal').classList.add('active');
  const close = document.querySelector('#proModal .modal-close');
  if(close) close.focus();
}
function closeProModal(){
  document.getElementById('proModal').classList.remove('active');
  document.getElementById('licenseStatus').textContent = '';
}

document.getElementById('proModal').addEventListener('click', function(e){
  if(e.target === this) closeProModal();
});
document.addEventListener('keydown', function(e){
  if(e.key === 'Escape') closeProModal();
});

async function verifyLicense(){
  const value = document.getElementById('licenseEmail').value.trim();
  const status = document.getElementById('licenseStatus');
  if(!value){ status.textContent = 'Please enter your email or license key'; status.className = 'modal-status error'; return; }
  const payload = value.includes('@') ? { email: value } : { license_key: value };

  status.textContent = 'Checking...'; status.className = 'modal-status';
  try {
    const res = await fetch('/verify-pro', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if(data.pro){
      proEmail = data.email;
      localStorage.setItem('pro_email', proEmail);
      status.textContent = 'Pro is active. Reloading...';
      status.className = 'modal-status success';
      setTimeout(() => location.reload(), 1000);
    } else {
      status.textContent = payload.email
        ? 'Email not found. Paste the license key from your Gumroad receipt instead.'
        : 'That license key was not accepted. Check it against your Gumroad receipt.';
      status.className = 'modal-status error';
    }
  } catch(e){
    status.textContent = 'Connection error.';
    status.className = 'modal-status error';
  }
}

function updateProUI(){
  if(isProUser()){
    const btn = document.getElementById('navProBtn');
    if(btn){
      btn.textContent = 'Pro active';
      btn.classList.add('is-pro');
      btn.onclick = function(){
        if(confirm('Sign out of Pro on this device?')){
          localStorage.removeItem('pro_email');
          proEmail = '';
          location.reload();
        }
      };
    }
    document.getElementById('usageBar').innerHTML = '<strong>Pro:</strong> up to 150 pages a day';
  }
}

// Init
updateProUI();
renderGallery();
</script>

</body>
</html>
