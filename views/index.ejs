      <button type="button" class="example-chip" onclick="useExample(this)">unicorn princess with castle</button>
      <button type="button" class="example-chip" onclick="useExample(this)">intricate mandala with flowers</button>
      <button type="button" class="example-chip" onclick="useExample(this)">halloween pumpkin with bats</button>
      <button type="button" class="example-chip" onclick="useExample(this)">space astronaut on moon</button>
      <button type="button" class="example-chip" onclick="useExample(this)">mermaid underwater scene</button>
      <button type="button" class="example-chip" onclick="useExample(this)">cute robot with flowers</button>
      <button type="button" class="example-chip" onclick="useExample(this)">fairy with butterflies</button>
    </div>
  </div>

  <div class="loading" id="loadingArea" role="status">
    <div class="loading-spinner"></div>
    <div class="loading-text">Creating your coloring page...</div>
    <div class="loading-sub">This usually takes 10-20 seconds</div>
  </div>

  <div class="gallery-section" id="gallerySection">
    <h2>Your coloring pages</h2>
    <div class="gallery" id="gallery"></div>
    <div class="batch-actions">
      <button type="button" class="btn-generate" onclick="downloadAllPDF()">Download all as PDF book</button>
    </div>
  </div>
</div>

