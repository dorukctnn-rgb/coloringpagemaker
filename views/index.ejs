<script>
let selectedStyle = 'medium';
let generatedImages = JSON.parse(sessionStorage.getItem('generated_images') || '[]');
let proEmail = localStorage.getItem('pro_email') || '';

function isProUser(){ return !!proEmail; }

function selectStyle(style){
  selectedStyle = style;
  document.querySelectorAll('.option-card').forEach(c => c.classList.remove('active'));
  document.querySelector(`[data-style="${style}"]`).classList.add('active');
}

function useExample(el){
  document.getElementById('promptInput').value = el.textContent.trim();
  updateCharCount();
}

function updateCharCount(){
  const len = document.getElementById('promptInput').value.length;
  document.getElementById('charCount').textContent = len;
}

document.getElementById('promptInput').addEventListener('input', updateCharCount);

async function generatePage(){
  const prompt = document.getElementById('promptInput').value.trim();
  if(prompt.length < 3){
    alert('Please describe what you want to draw (at least 3 characters)');
    return;
  }

  const btn = document.getElementById('generateBtn');
  const loading = document.getElementById('loadingArea');
  btn.disabled = true;
  btn.textContent = '⏳ Generating...';
  loading.classList.add('active');

  try {
    const res = await fetch('/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt, style: selectedStyle, email: proEmail })
    });
    const data = await res.json();

    if(!res.ok){
      if(data.limitReached){
        loading.classList.remove('active');
        openProModal();
      } else {
        alert(data.error || 'Generation failed');
      }
      btn.disabled = false;
      btn.textContent = '✨ Generate Coloring Page';
      loading.classList.remove('active');
      return;
    }

    // Add to gallery
    generatedImages.unshift({ url: data.imageUrl, prompt, time: Date.now() });
    sessionStorage.setItem('generated_images', JSON.stringify(generatedImages.slice(0, 50)));
    renderGallery();

    // Update usage display
    if(data.remaining >= 0 && data.remaining < 999){
      document.getElementById('usageBar').innerHTML = data.remaining > 0
        ? `<strong>${data.remaining}</strong> free pages left today. <a href="javascript:void(0)" onclick="openProModal()" style="color:#ff6b9d;font-weight:600;text-decoration:none">Get unlimited →</a>`
        : `Daily limit reached. <a href="javascript:void(0)" onclick="openProModal()" style="color:#ff6b9d;font-weight:600;text-decoration:none">Upgrade for unlimited →</a>`;
    }
  } catch(e){
    alert('Connection error. Please try again.');
  }

  btn.disabled = false;
  btn.textContent = '✨ Generate Coloring Page';
  loading.classList.remove('active');
}

function renderGallery(){
  const section = document.getElementById('gallerySection');
  const gallery = document.getElementById('gallery');

  if(generatedImages.length === 0){
    section.classList.remove('active');
    return;
  }

  section.classList.add('active');
  gallery.innerHTML = generatedImages.map((img, i) => `
    <div class="image-card">
      <span class="label">${img.prompt.substring(0, 30)}${img.prompt.length > 30 ? '…' : ''}</span>
      <img src="${img.url}" alt="${img.prompt}" loading="lazy">
      <div class="actions">
        <button class="btn-small" onclick="downloadSingle('${img.url}', '${i}')">📄 PDF</button>
        <button class="btn-small btn-small-outline" onclick="downloadImage('${img.url}', '${i}')">🖼️ PNG</button>
        <button class="btn-small btn-small-outline" onclick="removeImage(${i})">🗑️</button>
      </div>
    </div>
  `).join('');
}

async function downloadSingle(url, idx){
  try {
    const res = await fetch('/download-pdf', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ imageUrls: [url], email: proEmail })
    });
    if(!res.ok) throw new Error();
    const blob = await res.blob();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `coloring-page-${idx}.pdf`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  } catch(e){ alert('Download failed'); }
}

async function downloadImage(url, idx){
  const a = document.createElement('a');
  a.href = url;
  a.download = `coloring-page-${idx}.png`;
  a.target = '_blank';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
}

async function downloadAllPDF(){
  if(generatedImages.length === 0) return;

  if(!isProUser() && generatedImages.length > 1){
    alert('Free version can only download 1 page per PDF. Upgrade to Pro to combine all pages into a coloring book!');
    openProModal();
    return;
  }

  try {
    const res = await fetch('/download-pdf', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ imageUrls: generatedImages.map(i => i.url), email: proEmail })
    });
    if(!res.ok) throw new Error();
    const blob = await res.blob();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `my-coloring-book.pdf`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  } catch(e){ alert('Download failed'); }
}

function removeImage(i){
  generatedImages.splice(i, 1);
  sessionStorage.setItem('generated_images', JSON.stringify(generatedImages));
  renderGallery();
}

function openProModal(){ document.getElementById('proModal').classList.add('active'); }
function closeProModal(){
  document.getElementById('proModal').classList.remove('active');
  document.getElementById('licenseStatus').textContent = '';
}

document.getElementById('proModal').addEventListener('click', function(e){
  if(e.target === this) closeProModal();
});

async function verifyLicense(){
  const email = document.getElementById('licenseEmail').value.trim();
  const status = document.getElementById('licenseStatus');
  if(!email){ status.textContent = 'Please enter your email'; status.className = 'modal-status error'; return; }

  status.textContent = 'Checking...'; status.className = 'modal-status';
  try {
    const res = await fetch('/verify-pro', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json();
    if(data.pro){
      proEmail = data.email;
      localStorage.setItem('pro_email', proEmail);
      status.textContent = '✓ Pro unlocked! Refreshing...';
      status.className = 'modal-status success';
      setTimeout(() => location.reload(), 1000);
    } else {
      status.textContent = 'Email not found. Recently purchased? Wait a minute and retry.';
      status.className = 'modal-status error';
    }
  } catch(e){
    status.textContent = 'Connection error.';
    status.className = 'modal-status error';
  }
}

function updateProUI(){
  if(isProUser()){
    const btn = document.getElementById('navProBtn');
    if(btn){
      btn.innerHTML = '✓ Pro';
      btn.style.background = '#0d8043';
      btn.onclick = function(){
        if(confirm('Sign out of Pro on this device?')){
          localStorage.removeItem('pro_email');
          proEmail = '';
          location.reload();
        }
      };
    }
    document.getElementById('usageBar').innerHTML = '✨ <strong>Pro:</strong> Unlimited generation';
  }
}

// Init
updateProUI();
renderGallery();
</script>

