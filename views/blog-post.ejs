<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= post.title.length + 20 <= 70 ? post.title + " | ColoringPageMaker" : post.title %></title>
<meta name="description" content="<%= post.description %>">
<meta property="og:type" content="article">
<meta property="og:title" content="<%= post.title %>">
<meta property="og:description" content="<%= post.description %>">
<meta property="og:image" content="https://www.coloringpagemaker.app/og-image.png">
<meta property="og:url" content="https://www.coloringpagemaker.app/<%= slug %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://www.coloringpagemaker.app/og-image.png">
<meta name="google-site-verification" content="FbTHVuCc47YEKFw9nyT2XbH2ZgpbtjZPZce7boWZgH0" />
<meta name="p:domain_verify" content="13cf5111c1b82113fad5ae7932381a41"/>
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="canonical" href="https://www.coloringpagemaker.app/<%= slug %>">
<%- include('partials/head-assets') %>
<script type="application/ld+json"><%- JSON.stringify({"@context":"https://schema.org","@graph":[{"@type":"Article",headline:post.title,description:post.description,image:"https://www.coloringpagemaker.app/og-image.png",...(post.updated ? {dateModified:post.updated} : {}),author:{"@type":"Organization",name:"ColoringPageMaker"},publisher:{"@type":"Organization",name:"ColoringPageMaker",url:"https://www.coloringpagemaker.app/"},mainEntityOfPage:"https://www.coloringpagemaker.app/"+slug},{"@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Home",item:"https://www.coloringpagemaker.app/"},{"@type":"ListItem",position:2,name:"Blog",item:"https://www.coloringpagemaker.app/blog"},{"@type":"ListItem",position:3,name:post.title,item:"https://www.coloringpagemaker.app/"+slug}]}]}).replace(/</g,"\\u003c") %></script>
</head>
<body>

<%- include('partials/nav') %>

<main id="main">
<article class="post">
  <div class="meta"><%= post.date %> &middot; <%= post.read %> read</div>
  <h1><%= post.title %></h1>

  <%# The mid-article CTA goes at the end of a section (just before an h2), from the fifth block on. %>
  <% let ctaAt = -1; for (let i = 4; i < post.content.length - 1; i++) { if (post.content[i].type !== 'h2' && post.content[i + 1].type === 'h2') { ctaAt = i; break; } } %>
  <% post.content.forEach(function(block, idx){ %>
    <% if(block.type === 'h2'){ %>
      <h2><%= block.text %></h2>
    <% } else if(block.type === 'sources'){ %>
      <% const perLink = block.links.every(function(l){ return l.checked; }); %>
      <aside class="sources" aria-label="Sources">
        <p class="sources-label"><%= block.checked ? 'Sources, last checked ' + block.checked : (perLink ? 'Sources' : 'Sources, last checked 7 October 2026') %></p>
        <ul>
          <% block.links.forEach(function(l){ %><li><a href="<%= l.href %>" rel="noopener"><%= l.text %></a><% if (l.checked && !block.checked) { %> (checked <%= l.checked %>)<% } %></li><% }); %>
        </ul>
      </aside>
    <% } else if(block.type === 'ul'){ %>
      <ul class="post-list-items">
        <% block.items.forEach(function(item){ %><li><%- md(item) %></li><% }); %>
      </ul>
    <% } else if(block.type === 'table'){ %>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><% block.head.forEach(function(h){ %><th scope="col"><%= h %></th><% }); %></tr></thead>
          <tbody>
            <% block.rows.forEach(function(row){ %><tr><% row.forEach(function(cell, ci){ %><% if (ci === 0) { %><th scope="row"><%- md(cell) %></th><% } else { %><td data-label="<%= block.head[ci] %>"><%- md(cell) %></td><% } %><% }); %></tr><% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p><%- md(block.text) %></p>
    <% } %>

    <% if(idx === ctaAt){ %>
      <aside class="cta">
        <h3>Try the AI coloring page generator</h3>
        <p>Free, no signup. Type an idea and get a printable coloring page in under a minute.</p>
        <a href="/" class="btn">Open the generator</a>
      </aside>
    <% } %>
  <% }); %>

  <aside class="cta">
    <h3>Build your own coloring book</h3>
    <p>Pro generates up to 150 pages a day and includes a commercial license for Etsy and KDP.</p>
    <a href="/" class="btn">Open the generator</a>
  </aside>
</article>

<section class="related">
  <h2>Continue reading</h2>
  <ul class="theme-list" style="grid-template-columns:repeat(2,minmax(0,1fr))">
    <% allPosts.forEach(function(p){ %>
      <li><a href="/<%= p.slug %>"><strong><%= p.title %></strong></a></li>
    <% }); %>
  </ul>
</section>
</main>

<%- include('partials/footer') %>

</body>
</html>
