<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Coloring Book Blog: Etsy, KDP and AI Guides | ColoringPageMaker</title>
<meta name="description" content="Free guides on selling coloring books on Etsy &amp; KDP, AI tools, mental health benefits of coloring, and classroom use.">
<meta property="og:title" content="Coloring Book Blog: Etsy, KDP and AI Guides">
<meta property="og:description" content="Free guides on selling coloring books on Etsy &amp; KDP, AI tools, mental health benefits of coloring, and classroom use.">
<meta property="og:image" content="https://www.coloringpagemaker.app/og-image.png">
<meta property="og:url" content="https://www.coloringpagemaker.app/blog">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://www.coloringpagemaker.app/og-image.png">
<meta name="google-site-verification" content="FbTHVuCc47YEKFw9nyT2XbH2ZgpbtjZPZce7boWZgH0" />
<meta name="p:domain_verify" content="13cf5111c1b82113fad5ae7932381a41"/>
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="canonical" href="https://www.coloringpagemaker.app/blog">
<%- include('partials/head-assets') %>
</head>
<body>

<%- include('partials/nav') %>

<main id="main">
<header class="page-head">
  <div class="wrap" style="max-width:900px">
    <p class="eyebrow">Blog</p>
    <h1>Coloring book blog</h1>
    <p>Guides for Etsy sellers, KDP self-publishers, teachers, and anyone who colors.</p>
  </div>
</header>

<div class="post-list">
  <% posts.forEach(function(p){ %>
    <a href="/<%= p.slug %>" class="post-card">
      <div class="meta"><%= p.date %> &middot; <%= p.read %> read</div>
      <h2><%= p.title %></h2>
      <p><%= p.description %></p>
    </a>
  <% }); %>
</div>
</main>

<%- include('partials/footer') %>

</body>
</html>
