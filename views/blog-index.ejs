<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Coloring Book Blog — Etsy, KDP, AI Tips | ColoringPageMaker</title>
<meta name="description" content="Free guides on selling coloring books on Etsy & KDP, AI tools, mental health benefits of coloring, and creative tips.">
<meta property="og:title" content="Coloring Book Blog — Etsy, KDP, AI Tips">
<meta property="og:description" content="Free guides on selling coloring books on Etsy & KDP, AI tools, mental health benefits, and creative tips.">
<meta property="og:image" content="https://coloringpagemaker.app/og-image.png">
<meta property="og:url" content="https://coloringpagemaker.app/blog">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://coloringpagemaker.app/og-image.png">
<meta name="google-site-verification" content="FbTHVuCc47YEKFw9nyT2XbH2ZgpbtjZPZce7boWZgH0" />
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="canonical" href="https://coloringpagemaker.app/blog">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#fff8f0;color:#2d1a4a;line-height:1.6}
.nav{background:#fff;border-bottom:2px solid #ffe5b4;padding:14px 0}
.nav-inner{max-width:1200px;margin:0 auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:20px;font-weight:800;color:#ff6b9d;text-decoration:none}
.nav-links a{color:#5a4a7a;text-decoration:none;margin-left:18px;font-size:14px;font-weight:500}

.hero{padding:60px 20px 30px;text-align:center;background:#fff;border-bottom:2px solid #ffe5b4}
.hero h1{font-size:42px;font-weight:900;margin-bottom:12px;letter-spacing:-0.5px}
.hero p{font-size:17px;color:#5a4a7a;max-width:600px;margin:0 auto}

.posts{max-width:900px;margin:50px auto;padding:0 20px;display:grid;gap:18px}
.post-card{background:#fff;border:2px solid #ffe5b4;border-radius:18px;padding:28px;text-decoration:none;color:#2d1a4a;display:block;transition:all .15s}
.post-card:hover{border-color:#ff6b9d;transform:translateY(-3px);box-shadow:0 6px 20px rgba(255,107,157,.1)}
.post-card .meta{font-size:12px;color:#888;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px}
.post-card h2{font-size:22px;font-weight:700;margin-bottom:10px;line-height:1.3}
.post-card p{color:#5a4a7a;font-size:15px}

footer{background:#2d1a4a;color:#c5b4e0;padding:30px 20px;text-align:center;margin-top:60px;font-size:13px}
footer a{color:#fff;text-decoration:none;margin:0 10px}
</style>
</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="logo">🎨 ColoringPageMaker</a>
    <div class="nav-links">
      <a href="/">Generator</a>
    </div>
  </div>
</nav>

<section class="hero">
  <h1>Coloring Book Blog</h1>
  <p>Guides for Etsy sellers, KDP self-publishers, teachers, and color enthusiasts.</p>
</section>

<div class="posts">
  <% posts.forEach(function(p){ %>
    <a href="/<%= p.slug %>" class="post-card">
      <div class="meta"><%= p.date %> • <%= p.read %> read</div>
      <h2><%= p.title %></h2>
      <p><%= p.description %></p>
    </a>
  <% }); %>
</div>

<footer>
  <div>
    <a href="/">Home</a>
    <a href="/blog">Blog</a>
  </div>
  <div style="margin-top:16px">© 2026 ColoringPageMaker</div>
</footer>

</body>
</html>
