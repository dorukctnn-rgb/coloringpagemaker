<%
  var title = 'Privacy Policy | ColoringPageMaker';
  var desc = 'What ColoringPageMaker does with your data: descriptions sent to OpenAI, daily limits counted by IP address, the Pro email we keep and who else receives data.';
  var url = 'https://www.coloringpagemaker.app/privacy';
%><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta name="description" content="<%= desc %>">
