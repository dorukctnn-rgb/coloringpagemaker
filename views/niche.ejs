<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= page.title %></title>
<meta name="description" content="<%= page.description %>">
<meta property="og:title" content="<%= page.title %>">
<meta property="og:description" content="<%= page.description %>">
<meta property="og:image" content="https://www.coloringpagemaker.app/og-image.png">
<meta property="og:url" content="https://www.coloringpagemaker.app/<%= slug %>">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://www.coloringpagemaker.app/og-image.png">
<meta name="google-site-verification" content="FbTHVuCc47YEKFw9nyT2XbH2ZgpbtjZPZce7boWZgH0" />
