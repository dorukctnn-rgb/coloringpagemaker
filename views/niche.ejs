<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#fff8f0;color:#2d1a4a;line-height:1.6}
.nav{background:#fff;border-bottom:2px solid #ffe5b4;padding:14px 0;position:sticky;top:0;z-index:50}
