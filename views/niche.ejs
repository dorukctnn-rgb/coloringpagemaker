.hero .lead{font-size:18px;color:#5a4a7a;max-width:680px;margin:0 auto 20px;line-height:1.5}
.hero .badges{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
.badge{display:inline-block;background:#fff;color:#0a2540;padding:6px 14px;border-radius:20px;font-size:13px;font-weight:600;border:2px solid #ffe5b4}

.tool-section{max-width:900px;margin:30px auto;padding:0 20px}
