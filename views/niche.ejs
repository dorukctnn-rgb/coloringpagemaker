<script>
let proEmail = localStorage.getItem('pro_email') || '';
let generatedImages = [];

function useExample(el){
  document.getElementById('promptInput').value = el.textContent.trim();
}

function toggleFAQ(el){
  el.classList.toggle('open');
  const answer = el.nextElementSibling;
  answer.classList.toggle('open');
}

async function generatePage(){
  const prompt = document.getElementById('promptInput').value.trim();
  if(prompt.length < 3){ alert('Please describe what you want'); return; }

  const btn = document.getElementById('generateBtn');
  const loading = document.getElementById('loadingArea');
  btn.disabled = true; btn.textContent = '⏳ Generating...';
  loading.classList.add('active');

  try {
    const res = await fetch('/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt, style: 'medium', email: proEmail })
    });
    const data = await res.json();

    if(!res.ok){
      alert(data.error || 'Failed');
      btn.disabled = false; btn.textContent = '✨ Generate Coloring Page';
      loading.classList.remove('active');
      return;
    }

    generatedImages.unshift({ url: data.imageUrl, prompt });
    renderGallery();
  } catch(e){ alert('Connection error'); }

  btn.disabled = false; btn.textContent = '✨ Generate Coloring Page';
  loading.classList.remove('active');
}

function renderGallery(){
  const section = document.getElementById('gallerySection');
  const gallery = document.getElementById('gallery');
  if(generatedImages.length === 0){ section.classList.remove('active'); return; }
  section.classList.add('active');
  gallery.innerHTML = generatedImages.map((img, i) => `
    <div class="image-card">
      <img src="${img.url}" alt="${img.prompt}" loading="lazy">
      <div class="actions">
        <button class="btn-small" onclick="downloadPDF('${img.url}', ${i})">📄 PDF</button>
      </div>
    </div>
  `).join('');
}

async function downloadPDF(url, idx){
  try {
    const res = await fetch('/download-pdf', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ imageUrls: [url], email: proEmail })
    });
    const blob = await res.blob();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `coloring-page.pdf`;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
  } catch(e){ alert('Download failed'); }
}
</script>

</body>
