<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="canonical" href="https://www.coloringpagemaker.app/<%= slug %>">
<%- include('partials/head-assets') %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "<%= page.h1 %> generator",
  "applicationCategory": "DesignApplication",
  "description": "<%= page.description %>",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "operatingSystem": "Web Browser",
  "url": "https://www.coloringpagemaker.app/<%= slug %>"
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is this <%= page.keyword %> generator really free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, it is free for personal use. Generate up to 2 coloring pages per day at no cost, no signup required. The Pro upgrade ($9 lifetime) is only needed if you want more than 2 pages a day (up to 150), commercial use rights, and the multi-page PDF book maker."
      }
    },
    {
      "@type": "Question",
      "name": "Can I print the coloring pages at home?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Every coloring page is generated at 1024x1024 resolution, which prints crisp at 8.5x11 inches on standard home printers. The PDF download button gives you a print-ready file in seconds."
      }
    },
    {
      "@type": "Question",
      "name": "Can I sell these on Etsy or KDP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Pro license ($9 one-time) includes full commercial rights, meaning you can sell the generated coloring pages on Etsy, Amazon KDP, your own website, or any print-on-demand platform. The free tier is personal use only."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need an account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No account, no email, no signup needed for the free tier. Just type your idea, click generate, and download."
      }
    }
  ]
}
</script>
</head>
<body>

<%- include('partials/nav') %>

<main id="main">
<header class="hero hero-wide">
  <div class="wrap">
    <p class="eyebrow">Free AI generator</p>
    <h1><%= page.h1 %></h1>
    <p class="lead"><%= page.intro %></p>
    <ul class="facts-inline">
      <li>2 free pages a day</li>
      <li>No signup</li>
      <li>Print-ready PDF</li>
    </ul>
  </div>
</header>

<div class="tool-section narrow">
  <div class="tool-card">
    <h2>Generate your <%= page.keyword %></h2>
    <label class="field-label" for="promptInput">Your idea</label>
    <textarea id="promptInput" placeholder="<%= page.examples[0] %>"><%= page.presetPrompt %></textarea>
    <button type="button" class="btn-generate" id="generateBtn" onclick="generatePage()">Generate coloring page</button>

    <div class="examples-bar">
      <h3>Example prompts</h3>
      <% page.examples.forEach(function(ex){ %>
        <button type="button" class="example-chip" onclick="useExample(this)"><%= ex %></button>
      <% }); %>
    </div>
  </div>

  <div class="loading" id="loadingArea" role="status">
    <div class="loading-spinner"></div>
    <p class="loading-text">Creating your <%= page.keyword %>...</p>
  </div>

  <div class="gallery-section" id="gallerySection">
    <h2>Your pages</h2>
    <div class="gallery" id="gallery"></div>
  </div>
</div>

<article class="content">

  <h2>About <%= page.keyword %></h2>
  <p><%= page.intro %></p>

  <p>This <%= page.keyword %> generator is for parents who need a page for this afternoon, teachers building classroom resources, Etsy sellers stocking a digital downloads shop, and self-publishers preparing books for Amazon KDP. Stock coloring pages tend to look alike. Here every page is generated from your own description.</p>

  <p>Pages are drawn by an <strong>OpenAI image model</strong>. It reads your text description and returns a clean black-and-white line drawing made for coloring. Instead of searching Pinterest for an hour, you type the idea and the page is ready in about 30 seconds.</p>

  <h2>How to generate the right coloring page</h2>

  <ol class="steps">
    <li>
      <h4>Describe your idea</h4>
      <p>Type a clear description in the box above. Be specific: "cute baby unicorn in a flower field with butterflies" works better than just "unicorn."</p>
    </li>
    <li>
      <h4>Click generate</h4>
      <p>Press the generate button and wait 30-40 seconds while your page is drawn at 1024×1024 resolution.</p>
    </li>
    <li>
      <h4>Download the PDF</h4>
      <p>Click the PDF button to download. The file is print-ready at 8.5×11 inches and works with any home printer.</p>
    </li>
  </ol>

  <div class="tips-box">
    <h3>Tips for better results</h3>
    <ul>
      <li><strong>Be specific in your prompt.</strong> Instead of "cat," try "fluffy orange cat sitting in a flower pot with butterflies around it."</li>
      <li><strong>Specify the age group.</strong> Adding "simple lines for young children" or "detailed for adults" changes the complexity.</li>
      <li><strong>Mention background elements.</strong> "...with rainbow background" or "...with cloud sky" makes the page feel finished.</li>
      <li><strong>Try variations.</strong> The free tier gives 2 generations a day, so change one detail at a time instead of repeating the same prompt.</li>
      <li><strong>For cleaner, sticker-style output</strong>, add "thick outline, simple shapes" to your prompt.</li>
    </ul>
  </div>

  <h2>Who uses this <%= page.keyword %> generator</h2>

  <h3>Parents and caregivers</h3>
  <p>The most common use. A child asks for "a unicorn coloring page" or "a dinosaur coloring page," and the Pinterest results look bland. Make one that matches exactly what your kid asked for, in under a minute. The free tier covers most family needs (2 pages a day is plenty for an afternoon activity).</p>

  <h3>Teachers and educators</h3>
  <p>Elementary and preschool teachers use this for themed classroom activities. Studying ancient Egypt? Generate Egyptian-themed coloring pages. Animal unit? Create pages of the exact animals you are teaching about. Custom pages matter in class because generic coloring pages do not reinforce lesson content, while custom ones do.</p>

  <h3>Etsy and KDP sellers</h3>
  <p>Printable coloring books are an established digital-download category on Etsy and in KDP low-content books. With the Pro license ($9 lifetime) you get commercial rights to sell anything you generate, which makes it a low-cost way to build a coloring book catalog from scratch.</p>

  <h3>Mindfulness and self-care</h3>
  <p>Many adults color to unwind after work or before bed. Generate detailed mandala-style pages in the style you prefer (botanical, geometric, animal-based) whenever you want a calm break.</p>

  <h2>Why generate instead of downloading stock pages</h2>

  <p>Traditional sources for coloring pages have three problems: <strong>limited variety</strong> (the same 20 designs everywhere), <strong>copyright issues</strong> (many "free" sites host pirated Disney or Pokemon characters), and <strong>dated quality</strong> (designs from 2010 that look outdated).</p>

  <p>Generating pages addresses all three. Each page is drawn fresh from your description (if you plan to sell pages, describe original characters rather than trademarked ones). The art style is modern and clean, and there is no library to run out of.</p>

  <p>For schools and businesses, the copyright angle matters most. Schools cannot legally distribute Disney coloring pages without a license. Original pages generated from your own description avoid that problem, and you own what you create (the Pro tier explicitly grants full commercial rights).</p>

  <h2>Print quality and format</h2>

  <p>Every coloring page is generated at <strong>1024×1024 pixels</strong>, which scales to standard 8.5×11 inch home printing. The PDF download is print-ready: no resizing, no margin adjustments, no software beyond a basic PDF viewer.</p>

  <p>The lines are pure black on a white background, with no gray, shading or gradient pixels that would print as muddy patches. That matters for kids using crayons, colored pencils or markers, who need clean spaces to color within.</p>

  <p>For commercial printing (Amazon KDP, professional print shops), 1024×1024 pixels is sized for book pages at 8.5×11. For larger formats such as posters, the lines will look soft, so stay with letter-size pages.</p>

</article>

<div class="wrap">
  <div class="pricing-cta">
    <h2>Make whole coloring books with Pro</h2>
    <p>One payment of $9 covers up to 150 <%= page.keyword %> a day, PDFs without a watermark, the multi-page PDF book maker, and a commercial license to sell on Etsy &amp; KDP.</p>
    <a href="https://dorukctn.gumroad.com/l/uynqt" target="_blank" rel="noopener" class="btn">Get Pro for $9</a>
  </div>
</div>

<section class="faq-section">
  <h2>Frequently asked questions</h2>

  <div class="faq-list">
    <details class="faq-item">
      <summary>Is this <%= page.keyword %> generator really free?</summary>
      <p>Yes, it is free for personal use. Generate up to 2 coloring pages per day at no cost, no signup required. The Pro upgrade ($9 lifetime) is only needed if you want more than 2 pages a day (up to 150), commercial use rights, and the multi-page PDF book maker.</p>
    </details>

    <details class="faq-item">
      <summary>Can I print the coloring pages at home?</summary>
      <p>Yes. Every coloring page is generated at 1024×1024 resolution, which prints crisp at 8.5×11 inches on standard home printers. The PDF download button gives you a print-ready file in seconds.</p>
    </details>

    <details class="faq-item">
      <summary>Can I sell these <%= page.keyword %> on Etsy or KDP?</summary>
      <p>The Pro license ($9 one-time) includes full commercial rights, meaning you can sell the generated coloring pages on Etsy, Amazon KDP, your own website, or any print-on-demand platform. The free tier is personal use only.</p>
    </details>

    <details class="faq-item">
      <summary>Do I need an account?</summary>
      <p>No account, no email, no signup needed for the free tier. Just type your idea, click generate, and download. The Pro version uses your purchase email to activate its features.</p>
    </details>

    <details class="faq-item">
      <summary>What if I don't like the generated page?</summary>
      <p>Try again with a more specific prompt. Free generations are limited to 2 per day, so make each one count. Adding details like style, mood, or background elements usually produces better results. With Pro, you can iterate as many times as needed, up to 150 pages a day.</p>
    </details>

    <details class="faq-item">
      <summary>What ages are these suitable for?</summary>
      <p>Coloring pages work for ages 3 and up. For younger kids, use prompts that specify "simple, thick lines, few details." For older kids and adults, add "intricate" or "detailed" to your prompt for more complex designs.</p>
    </details>
  </div>
</section>

<section class="related">
  <h2>Browse more themes</h2>
  <ul class="theme-list">
    <% allPages.forEach(function(p){ %>
      <li><a href="/<%= p.slug %>"><strong><%= p.h1 %></strong></a></li>
    <% }); %>
  </ul>
</section>
</main>

<%- include('partials/footer') %>

<script>
let proEmail = localStorage.getItem('pro_email') || '';
let generatedImages = [];

function esc(s){
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function useExample(el){
  document.getElementById('promptInput').value = el.textContent.trim();
}

async function generatePage(){
  const prompt = document.getElementById('promptInput').value.trim();
  if(prompt.length < 3){ alert('Please describe what you want'); return; }

  const btn = document.getElementById('generateBtn');
  const loading = document.getElementById('loadingArea');
  btn.disabled = true; btn.textContent = 'Generating...';
  loading.classList.add('active');

  try {
    const res = await fetch('/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt, style: 'medium', email: proEmail })
    });
    const data = await res.json();

    if(!res.ok){
      alert(data.error || 'Failed');
      btn.disabled = false; btn.textContent = 'Generate coloring page';
      loading.classList.remove('active');
      return;
    }

    generatedImages.unshift({ url: data.imageUrl, prompt });
    renderGallery();
  } catch(e){ alert('Connection error'); }

  btn.disabled = false; btn.textContent = 'Generate coloring page';
  loading.classList.remove('active');
}

function renderGallery(){
  const section = document.getElementById('gallerySection');
  const gallery = document.getElementById('gallery');
  if(generatedImages.length === 0){ section.classList.remove('active'); return; }
  section.classList.add('active');
  gallery.innerHTML = generatedImages.map((img, i) => `
    <div class="image-card">
      <img src="${img.url}" alt="${esc(img.prompt)}" loading="lazy">
      <div class="actions">
        <button type="button" class="btn-small" onclick="downloadPDF('${img.url}', ${i})">PDF</button>
      </div>
    </div>
  `).join('');
}

async function downloadPDF(url, idx){
  try {
    const res = await fetch('/download-pdf', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ imageUrls: [url], email: proEmail })
    });
    const blob = await res.blob();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `coloring-page.pdf`;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
  } catch(e){ alert('Download failed'); }
}
</script>

</body>
</html>
