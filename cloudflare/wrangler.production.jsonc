// PRODUCTION Worker "coloringpagemaker". Deploy ONLY at the switch (steps: takip/devir/coloringpagemaker.md):
//   node cloudflare/build.mjs && (cd cloudflare && wrangler deploy -c wrangler.production.jsonc)
// It first answers on https://coloringpagemaker.railer-iot.workers.dev for the URL check; www.coloringpagemaker.app
// is attached as a Custom Domain in the dashboard at the cut (then set workers_dev to false and deploy again).
// Secrets (wrangler secret put <NAME> -c wrangler.production.jsonc): OPENAI_API_KEY, IP_SALT.
{
  "name": "coloringpagemaker",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // The Worker answers these itself, as the old Express server did: 301 for a trailing slash, 404 for x.html.
    "run_worker_first": ["/*/", "/*.html", "/*.HTML", "/404", "/index"]
  },
  "ai": { "binding": "AI" },
  "images": { "binding": "IMAGES" },
  "durable_objects": { "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }],
  "observability": { "enabled": true },
  "vars": {
    "FREE_ENGINE": "flux",
    "HD_ENABLED": "1",
    "HD_COST_USD": "0.06",
    "HD_MONTHLY_CAP_USD": "9",
    "HD_DAILY_CAP_USD": "1.5",
    "HD_MONTHLY_ALLOWANCE": "50",
    // The day the Gumroad text with the monthly HD allowance went live. Sales before it keep their terms
    // (150 pages a day, HD while the shared budget lasts); the Gumroad text names the same day.
    "HD_TERMS_FROM": "2026-10-21",
    "PRO_DAILY_LIMIT": "150",
    "FREE_GLOBAL_DAILY_LIMIT": "120",
    "AI_DAILY_LIMIT": "160",
    // The old Vercel server, asked once for Pro tokens made before the move. Remove when Vercel is gone.
    "LEGACY_VERIFY_URL": "https://coloringpagemaker.vercel.app"
  }
}
